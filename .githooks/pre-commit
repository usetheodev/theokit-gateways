#!/usr/bin/env bash
# Git pre-commit hook.
#
#   GATE 1. Secret scanning — TruffleHog over the staged content.
#
# Lint, typecheck and tests are deliberately not run here: a slow pre-commit is a
# pre-commit people learn to bypass with --no-verify, which costs more than it saves.
# They run in CI instead — see .github/workflows/ci.yml. That was NOT true until
# 2026-08-17: this comment claimed the suite was "cheap in CI" while no workflow ran
# it at all, so the tests were skipped here on the strength of a gate that did not
# exist. If ci.yml is ever removed, this paragraph becomes a lie again and the tests
# belong back in this hook.
#
# Secret scanning is the exception that earns its place locally:
# CI can only catch a credential after it is already written to the history, and from
# that moment the only real remedy is rotating it at the provider. This hook is the
# last point where a leak is still free to fix.

set -e

ROOT="$(git rev-parse --show-toplevel)"

"$ROOT/.githooks/secret-scan.sh"
