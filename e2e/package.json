{
  "name": "@theokit/gateway-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Live end-to-end tests against the real platform APIs. Deliberately has no \"test\" script: `pnpm -r run test` must never spend money or post into a chat.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "e2e": "vitest run",
    "e2e:watch": "vitest",
    "readiness": "vitest run tests/readiness.test.ts",
    "typecheck": "tsc --noEmit",
    "env:example": "tsx scripts/env-example.ts",
    "discover:telegram": "tsx scripts/discover-telegram.ts",
    "session:telegram": "tsx scripts/mint-telegram-session.ts",
    "bootstrap:telegram": "tsx scripts/bootstrap-telegram.ts"
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/gateway-discord": "workspace:*",
    "@theokit/gateway-email": "workspace:*",
    "@theokit/gateway-slack": "workspace:*",
    "@theokit/gateway-telegram": "workspace:*",
    "@types/node": "^22.10.0",
    "telegram": "^2.26.22",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  }
}
