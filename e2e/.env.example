# Live end-to-end credentials — GENERATED, do not edit by hand.
# Regenerate: pnpm --filter @theokit/gateway-e2e env:example
#
# Copy to `e2e/.env` and fill in what you have. Missing platforms SKIP with a
# named reason; they never fail and never run against a placeholder.
#
# Every target below must point at a THROWAWAY chat, channel, room or number.
# These tests send real messages.

# Master switch. Without it every live suite skips, so a stray `pnpm e2e`
# cannot spend money or post into a chat by accident.
E2E_LIVE=0

# ========================================================================
# Telegram  —  @theokit/gateway-telegram
# transport: connection (full round trip runs anywhere, including CI)
# ========================================================================
# Bot token, `<id>:<secret>`
#   where: Message @BotFather → /newbot (or /token for an existing bot)
TELEGRAM_BOT_TOKEN=
# Numeric chat id the test may post into
#   where: Create a throwaway group, add the bot, send it one message, then read the id from getUpdates (`pnpm --filter @theokit/gateway-e2e discover:telegram`)
TELEGRAM_TEST_CHAT_ID=

# ========================================================================
# Discord  —  @theokit/gateway-discord
# transport: connection (full round trip runs anywhere, including CI)
# NOTE: MESSAGE CONTENT is a privileged intent: enable it under Bot → Privileged Gateway Intents, or inbound arrives with empty text.
# ========================================================================
# Bot token
#   where: discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Channel id the bot may post into
#   where: Create a throwaway server, invite the bot with Send Messages, enable Developer Mode, right-click the channel → Copy Channel ID
DISCORD_TEST_CHANNEL_ID=

# ========================================================================
# Slack  —  @theokit/gateway-slack
# transport: connection (full round trip runs anywhere, including CI)
# NOTE: Socket Mode must be ON for inbound; without it the app token is accepted but no events arrive.
# ========================================================================
# Bot user token, `xoxb-…`
#   where: api.slack.com/apps → your app → OAuth & Permissions → install to workspace
SLACK_BOT_TOKEN=
# App-level token, `xapp-…`, scope `connections:write`
#   where: api.slack.com/apps → your app → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=
# Channel id, `C…`
#   where: Create a throwaway channel, invite the bot, then View channel details → bottom
SLACK_TEST_CHANNEL_ID=

# ========================================================================
# Matrix  —  @theokit/gateway-matrix
# transport: connection (full round trip runs anywhere, including CI)
# ========================================================================
# Homeserver base URL
#   where: e.g. https://matrix.org, or your own server
MATRIX_HOMESERVER_URL=
# Access token for the bot account
#   where: Element → Settings → Help & About → Advanced → Access Token
MATRIX_ACCESS_TOKEN=
# Full mxid, `@bot:server`
#   where: The bot's own user id
MATRIX_USER_ID=
# Room id, `!abc:server`
#   where: Create a throwaway room, invite and JOIN the bot, then Room Settings → Advanced
MATRIX_TEST_ROOM_ID=

# ========================================================================
# Mattermost  —  @theokit/gateway-mattermost
# transport: connection (full round trip runs anywhere, including CI)
# ========================================================================
# Server base URL
#   where: Your Mattermost instance, e.g. https://mm.example.com
MATTERMOST_BASE_URL=
# Personal access token for the bot account
#   where: Profile → Security → Personal Access Tokens (admin must enable them first)
MATTERMOST_ACCESS_TOKEN=
# Channel id
#   where: Create a throwaway channel, add the bot, then View Info → channel id
MATTERMOST_TEST_CHANNEL_ID=

# ========================================================================
# Email (IMAP + SMTP)  —  @theokit/gateway-email
# transport: connection (full round trip runs anywhere, including CI)
# NOTE: Delivery is not instant. Inbound assertions poll with a generous timeout.
# ========================================================================
# Mailbox the bot owns
#   where: A throwaway mailbox
EMAIL_ADDRESS=
# App password, never the account password
#   where: Gmail: myaccount.google.com/apppasswords (needs 2FA on)
EMAIL_PASSWORD=
# IMAP host
#   where: Gmail: imap.gmail.com
EMAIL_IMAP_HOST=
# SMTP host
#   where: Gmail: smtp.gmail.com
EMAIL_SMTP_HOST=
# Address the test may write to
#   where: Use the bot's OWN address so the round trip needs one mailbox, not two
EMAIL_TEST_RECIPIENT=

# ========================================================================
# LINE  —  @theokit/gateway-line
# transport: webhook (inbound needs a public HTTPS URL; outbound and auth do not)
# NOTE: Inbound needs a public HTTPS webhook URL; outbound and auth run anywhere.
# ========================================================================
# Channel secret, used for the inbound HMAC
#   where: developers.line.biz → your channel → Basic settings
LINE_CHANNEL_SECRET=
# Long-lived channel access token
#   where: developers.line.biz → your channel → Messaging API → issue token
LINE_CHANNEL_ACCESS_TOKEN=
# User id, `U…`, that has added the bot
#   where: Add the bot as a friend, then read it from a webhook delivery or the console
LINE_TEST_USER_ID=

# ========================================================================
# Microsoft Teams  —  @theokit/gateway-teams
# transport: webhook (inbound needs a public HTTPS URL; outbound and auth do not)
# NOTE: Needs an Azure Bot resource with a messaging endpoint. Inbound requires a public HTTPS URL.
# ========================================================================
# App (client) id
#   where: Azure Portal → App registrations → your app
TEAMS_CLIENT_ID=
# Client secret
#   where: Azure Portal → App registrations → Certificates & secrets
TEAMS_CLIENT_SECRET=
# Directory (tenant) id
#   where: Azure Portal → App registrations → Overview
TEAMS_TENANT_ID=
# Conversation id to post into
#   where: Captured from an inbound activity once the bot is installed in a test team
TEAMS_TEST_CONVERSATION_ID=

# ========================================================================
# WhatsApp (Cloud API)  —  @theokit/gateway-whatsapp
# transport: webhook (inbound needs a public HTTPS URL; outbound and auth do not)
# NOTE: Outside the 24-hour customer service window only approved TEMPLATES send — a free-form text will be rejected by Meta, not by this code. The `web` backend is excluded here entirely: it drives a real WhatsApp Web session through a QR scan and cannot run unattended.
# ========================================================================
# Cloud API access token
#   where: developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
# Phone number id (not the phone number)
#   where: Same API Setup page
WHATSAPP_PHONE_NUMBER_ID=
# E.164 number allowed to receive test messages
#   where: Must be added as a recipient in API Setup while the app is in development mode
WHATSAPP_TEST_RECIPIENT=

# ========================================================================
# SMS (Twilio / Plivo / Vonage)  —  @theokit/gateway-sms
# transport: webhook (inbound needs a public HTTPS URL; outbound and auth do not)
# NOTE: Every outbound message costs real money. Inbound requires a public HTTPS webhook URL.
# ========================================================================
# Which provider to exercise: twilio | plivo | vonage
#   where: Your choice; the provider-specific vars below follow from it
SMS_BACKEND=
# Twilio Account SID / Plivo Auth ID / Vonage API key
#   where: The provider console dashboard
SMS_ACCOUNT_ID=
# Twilio Auth Token / Plivo Auth Token / Vonage API secret
#   where: The provider console dashboard
SMS_AUTH_TOKEN=
# E.164 sender number you own
#   where: The provider console → phone numbers
SMS_FROM_NUMBER=
# E.164 number the test may text
#   where: On a trial account this must be a VERIFIED number
SMS_TEST_RECIPIENT=

# Optional — a second Telegram bot, so the inbound round trip has a sender.
# A bot cannot see its own messages, and EC-K drops messages from other bots,
# so without this the inbound suite has nothing to receive.
TELEGRAM_TEST_SENDER_TOKEN=

# Optional — public HTTPS URL reaching this process (ngrok, cloudflared).
# Unlocks the inbound suites for the webhook platforms.
E2E_PUBLIC_URL=
